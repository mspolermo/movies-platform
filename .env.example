# ===========================================
# Общие настройки для Movies Platform
# ===========================================

COMPOSE_ENV_FILES=./devops/network.env,.env
# COMPOSE_PROFILES=tools

# Окружение
NODE_ENV=development

# JWT настройки (один PRIVATE_KEY для api-gateway + auth-users)
PRIVATE_KEY=your-super-secret-jwt-key-here
JWT_ACCESS_EXPIRES_IN=15m

# Базы данных (имена БД — devops/network.env; тут только creds)
# DX-only. @production код запрещает DX-пары / short pass (rmq.constants / rmq.factory).
POSTGRES_USER=mp_dev
POSTGRES_PASSWORD=mp_dev_change_me

# RabbitMQ (обязательны в .env — compose без :- DX fallback)
RABBITMQ_USER=mp
RABBITMQ_PASS=mp_dev_change_me
