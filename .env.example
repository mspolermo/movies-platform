# ===========================================
# Общие настройки для Movies Platform
# ===========================================

# Окружение
NODE_ENV=development

# JWT настройки (один PRIVATE_KEY для api-gateway + auth-users)
PRIVATE_KEY=your-super-secret-jwt-key-here
JWT_ACCESS_EXPIRES_IN=15m

# API gateway (SSR Next.js + rewrites; Docker: http://api-gateway:5000)
API_GATEWAY_URL=http://localhost:5001

# CORS / OriginGuard (через запятую)
ALLOWED_ORIGINS=http://localhost:3000

# Базы данных
POSTGRES_USER=root
POSTGRES_PASSWORD=root
POSTGRES_DB_KINO=kino
POSTGRES_DB_USER=user
POSTGRES_PORT=5432

# RabbitMQ
RABBITMQ_URL=amqp://rabbitmq:5672

# Очереди RabbitMQ
USERS_QUEUE=users_queue
FILMS_QUEUE=films_queue