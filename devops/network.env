# Зеркало apps/common/constants/network.ts для Compose (COMPOSE_ENV_FILES).
# Править вместе с network.ts. См. devops/README.md и ADR-009.

BIND_HOST=127.0.0.1

GATEWAY_PUBLISH_PORT=5001
GATEWAY_LISTEN_PORT=5000
AUTH_USERS_PUBLISH_PORT=3001
AUTH_USERS_LISTEN_PORT=3001
KINO_DB_PUBLISH_PORT=3002
KINO_DB_LISTEN_PORT=3002

POSTGRES_KINO_PUBLISH_PORT=5432
POSTGRES_USERS_PUBLISH_PORT=5433
POSTGRES_LISTEN_PORT=5432
POSTGRES_PORT=5432

# Имена БД (не секреты; USER/PASSWORD — в root .env)
POSTGRES_DB_KINO=kino
POSTGRES_DB_USER=user

RABBITMQ_AMQP_PUBLISH_PORT=5672
RABBITMQ_AMQP_LISTEN_PORT=5672
RABBITMQ_MGMT_PUBLISH_PORT=15672
RABBITMQ_MGMT_LISTEN_PORT=15672

PGADMIN_PUBLISH_PORT=5050
PGADMIN_LISTEN_PORT=80

CLIENT_ORIGIN=http://localhost:3000
API_GATEWAY_URL=http://localhost:5001
ALLOWED_ORIGINS=http://localhost:3000

# Host-run Nest only. App containers: compose собирает amqp://…@rabbitmq:…
RABBITMQ_URL=amqp://mp:mp_dev_change_me@localhost:5672
USERS_QUEUE=users_queue
FILMS_QUEUE=films_queue
